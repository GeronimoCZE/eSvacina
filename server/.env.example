# PostgreSQL connection string
DATABASE_URL=postgresql://esvacina:esvacina@localhost:5432/esvacina
# Optional: Redis for caching. Leave empty to use the in-memory cache.
REDIS_URL=redis://localhost:6379
# Long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string
# Comma separated list of origins allowed by CORS (the storefront URL)
CORS_ORIGIN=http://localhost:5173
PORT=4010
NODE_ENV=development
# Default cache TTL for public endpoints, in seconds
CACHE_TTL=60
# Admin account created by the seed script
ADMIN_EMAIL=admin@esvacina.cz
ADMIN_PASSWORD=Admin123!
# Public URL of the storefront (canonical links, sitemap, Open Graph images, Stripe redirects)
PUBLIC_URL=http://localhost:5173
# Stripe test keys from https://dashboard.stripe.com/test/apikeys. Leave empty for demo mode
# (online payments are confirmed instantly without charging anything).
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint pointing at /api/stripe/webhook (stripe listen prints one locally)
STRIPE_WEBHOOK_SECRET=
